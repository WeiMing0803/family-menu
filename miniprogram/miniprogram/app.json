{
  "pages": [
    "pages/index/index",
    "pages/menu/menu",
    "pages/dish-edit/dish-edit",
    "pages/history/history",
    "pages/family/family",
    "pages/login/login"
  ],
  "window": {
    "navigationBarTextStyle": "black",
    "navigationStyle": "custom",
    "backgroundColor": "#F7F5EE",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#86918A",
    "selectedColor": "#3F8F62",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "今日",
        "iconPath": "assets/tabbar/today.png",
        "selectedIconPath": "assets/tabbar/today-active.png"
      },
      {
        "pagePath": "pages/menu/menu",
        "text": "菜单",
        "iconPath": "assets/tabbar/menu.png",
        "selectedIconPath": "assets/tabbar/menu-active.png"
      },
      {
        "pagePath": "pages/history/history",
        "text": "历史",
        "iconPath": "assets/tabbar/history.png",
        "selectedIconPath": "assets/tabbar/history-active.png"
      },
      {
        "pagePath": "pages/family/family",
        "text": "家庭",
        "iconPath": "assets/tabbar/family.png",
        "selectedIconPath": "assets/tabbar/family-active.png"
      }
    ]
  },
  "usingComponents": {
    "navigation-bar": "/components/navigation-bar/navigation-bar",
    "dish-avatar": "/components/dish-avatar/dish-avatar",
    "empty-state": "/components/empty-state/empty-state",
    "van-button": "@vant/weapp/button/index",
    "van-icon": "@vant/weapp/icon/index",
    "van-search": "@vant/weapp/search/index",
    "van-swipe-cell": "@vant/weapp/swipe-cell/index",
    "van-action-sheet": "@vant/weapp/action-sheet/index",
    "van-popup": "@vant/weapp/popup/index",
    "van-field": "@vant/weapp/field/index",
    "van-tag": "@vant/weapp/tag/index",
    "van-cell": "@vant/weapp/cell/index",
    "van-cell-group": "@vant/weapp/cell-group/index",
    "van-switch": "@vant/weapp/switch/index",
    "van-loading": "@vant/weapp/loading/index"
  },
  "rendererOptions": {
    "skyline": {
      "defaultDisplayBlock": true,
      "disableABTest": true,
      "sdkVersionBegin": "3.0.0",
      "sdkVersionEnd": "15.255.255"
    }
  },
  "componentFramework": "glass-easel",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
