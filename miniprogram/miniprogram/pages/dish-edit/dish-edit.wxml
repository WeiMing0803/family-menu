<navigation-bar title="{{isEdit ? '编辑菜品' : '添加菜品'}}" back="{{true}}" color="#2C3630" background="#F7F5EE"></navigation-bar>
<view class="page">
  <view wx:if="{{loading}}" class="loading-state">
    <van-loading size="36rpx" color="#86918A" />
    <text>正在读取菜品…</text>
  </view>

  <block wx:else>
    <view class="preview">
      <dish-avatar name="{{name || '菜'}}" category="{{category}}" size="lg" />
      <text class="preview-name ellipsis">{{name || '给这道菜起个名字'}}</text>
      <text class="preview-meta">{{category}}<block wx:if="{{isFavorite}}"> · 喜欢</block></text>
    </view>

    <view wx:if="{{errorMessage}}" class="error-banner">{{errorMessage}}</view>

    <view class="form-card">
      <van-field
        value="{{name}}"
        label="菜名"
        placeholder="例如：番茄炒蛋"
        maxlength="{{100}}"
        clearable
        required
        error-message="{{nameError}}"
        bind:change="onNameChange"
      />
    </view>

    <view class="section-title"><text>分类</text></view>
    <view class="chip-row">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="chip {{category === item ? 'active' : ''}}"
        data-category="{{item}}"
        bindtap="selectCategory"
        aria-role="radio"
        aria-checked="{{category === item}}"
      >{{item}}</view>
    </view>

    <view class="section-title"><text>备注</text></view>
    <view class="form-card">
      <van-field
        value="{{remark}}"
        type="textarea"
        placeholder="口味、食材或做法提示（可选）"
        maxlength="{{500}}"
        autosize="{{ { minHeight: 96 } }}"
        show-word-limit
        border="{{false}}"
        bind:change="onRemarkChange"
      />
    </view>

    <view class="form-card favorite-card">
      <van-cell title="喜欢这道菜" label="会出现在菜单的「喜欢」筛选里" center border="{{false}}">
        <van-switch slot="right-icon" checked="{{isFavorite}}" size="44rpx" bind:change="onFavoriteChange" />
      </van-cell>
    </view>

    <view class="actions">
      <van-button type="primary" size="large" round block loading="{{saving}}" loading-text="正在保存…" disabled="{{deleting}}" bind:click="save">保存</van-button>
      <view wx:if="{{isEdit}}" class="text-button danger" bindtap="remove">
        <van-loading wx:if="{{deleting}}" size="28rpx" color="#C8553D" />
        <van-icon wx:else name="delete-o" />
        <text>删除这道菜</text>
      </view>
    </view>
  </block>
</view>
