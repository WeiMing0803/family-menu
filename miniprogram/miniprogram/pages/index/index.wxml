<template name="order-row">
  <van-swipe-cell right-width="{{72}}">
    <view class="order-row {{last ? 'last' : ''}} status-{{status}}" data-id="{{id}}" bindtap="openItemActions">
      <dish-avatar name="{{dishName}}" category="{{category}}" state="{{status === 'Done' ? 'done' : status === 'Cancelled' ? 'muted' : ''}}" />
      <view class="row-main">
        <text class="row-name ellipsis">{{dishName}}</text>
        <text class="row-meta ellipsis">{{category}}<block wx:if="{{addedByName}}"> · {{addedByName}}点的</block><block wx:if="{{remark}}"> · {{remark}}</block></text>
      </view>
      <view wx:if="{{status === 'Pending'}}" class="done-button" data-id="{{id}}" catchtap="markDone" aria-role="button" aria-label="标记已做完">
        <van-icon name="success" size="32rpx" />
      </view>
      <van-tag wx:elif="{{status === 'Done'}}" type="primary" plain round>已做完</van-tag>
      <text wx:else class="restore-link" data-id="{{id}}" catchtap="restore">恢复</text>
    </view>
    <view slot="right" class="swipe-delete" data-id="{{id}}" bindtap="onSwipeDelete">删除</view>
  </van-swipe-cell>
</template>

<navigation-bar title="" back="{{false}}" background="#F7F5EE"></navigation-bar>
<view class="page">
  <view class="page-header">
    <view>
      <text class="page-eyebrow">{{dateLabel}}<block wx:if="{{family}}"> · {{family.name}}</block></text>
      <text class="page-title">今天吃什么</text>
    </view>
    <view wx:if="{{members.length}}" class="member-stack" bindtap="goFamily" aria-role="button" aria-label="查看家庭成员">
      <view wx:for="{{members}}" wx:key="id" class="member-avatar {{item.isMe ? 'me' : ''}}">{{item.initial}}</view>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-banner">
    <text>{{errorMessage}}</text>
    <van-button size="small" round plain type="danger" bind:click="load">重试</van-button>
  </view>

  <view wx:if="{{loading}}" class="loading-state">
    <van-loading size="36rpx" color="#86918A" />
    <text>正在准备今天的菜单…</text>
  </view>

  <empty-state wx:elif="{{!family && !errorMessage}}" icon="friends-o" title="先建立一个家庭" description="创建家庭或输入邀请码，和家人共享菜单。">
    <van-button type="primary" round bind:click="goFamily">去创建或加入</van-button>
  </empty-state>

  <block wx:elif="{{family}}">
    <empty-state wx:if="{{!itemCount}}" icon="smile-o" title="还没有想吃的" description="去菜单挑几道，家人会实时看到。">
      <van-button type="primary" round bind:click="goMenu">去菜单挑菜</van-button>
    </empty-state>

    <block wx:if="{{pending.length}}">
      <view class="section-title"><text>想吃 · {{pending.length}}</text><text class="section-hint">点击更多 · 左滑删除</text></view>
      <view class="card list-card">
        <block wx:for="{{pending}}" wx:key="id">
          <template is="order-row" data="{{...item, last: index === pending.length - 1}}" />
        </block>
      </view>
    </block>

    <block wx:if="{{done.length}}">
      <view class="section-title"><text>已做完 · {{done.length}}</text></view>
      <view class="card list-card">
        <block wx:for="{{done}}" wx:key="id">
          <template is="order-row" data="{{...item, last: index === done.length - 1}}" />
        </block>
      </view>
    </block>

    <block wx:if="{{cancelled.length}}">
      <view class="section-title"><text>不吃了 · {{cancelled.length}}</text></view>
      <view class="card list-card">
        <block wx:for="{{cancelled}}" wx:key="id">
          <template is="order-row" data="{{...item, last: index === cancelled.length - 1}}" />
        </block>
      </view>
    </block>

    <view wx:if="{{itemCount}}" class="text-button danger clear-button" bindtap="clearOrder">
      <van-icon name="delete-o" />
      <text>清空今日点餐</text>
    </view>
  </block>
</view>

<van-action-sheet
  show="{{sheetShow}}"
  actions="{{sheetActions}}"
  description="{{sheetTitle}}"
  cancel-text="取消"
  bind:select="onSheetSelect"
  bind:close="closeSheet"
  bind:cancel="closeSheet"
/>
