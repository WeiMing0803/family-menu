<navigation-bar title="" back="{{false}}" background="#F7F5EE"></navigation-bar>
<view class="page menu-page">
  <view class="page-header">
    <view>
      <text class="page-eyebrow">{{family ? family.name : '还未加入家庭'}}</text>
      <text class="page-title">菜单</text>
    </view>
    <view wx:if="{{family}}" class="icon-button" bindtap="openCreate" aria-role="button" aria-label="添加菜品">
      <van-icon name="plus" size="36rpx" />
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-banner">
    <text>{{errorMessage}}</text>
    <van-button size="small" round plain type="danger" bind:click="load">重试</van-button>
  </view>

  <empty-state wx:if="{{!family && !loading && !errorMessage}}" icon="friends-o" title="加入家庭后开始共享菜单" description="菜单由家庭成员共同维护。">
    <van-button type="primary" round bind:click="goFamily">去创建或加入</van-button>
  </empty-state>

  <block wx:elif="{{family}}">
    <view class="search-box">
      <van-search
        value="{{search}}"
        placeholder="搜索菜名"
        shape="round"
        bind:change="onSearchChange"
        bind:search="onSearchConfirm"
        bind:clear="onSearchClear"
      />
    </view>

    <scroll-view class="chip-scroll" scroll-x enable-flex>
      <view class="chip-track">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          class="chip {{currentCategory === item ? 'active' : ''}}"
          data-category="{{item}}"
          bindtap="selectCategory"
        >{{item}}</view>
        <view class="chip {{favoriteOnly ? 'active' : ''}}" bindtap="toggleFavoriteFilter">
          <van-icon name="{{favoriteOnly ? 'like' : 'like-o'}}" size="26rpx" />
          <text>喜欢</text>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{loading}}" class="loading-state">
      <van-loading size="36rpx" color="#86918A" />
      <text>正在加载菜单…</text>
    </view>
    <empty-state
      wx:elif="{{!dishes.length}}"
      icon="notes-o"
      title="{{search || favoriteOnly || currentCategory !== '全部' ? '没有符合条件的菜' : '菜单还是空的'}}"
      description="{{search || favoriteOnly || currentCategory !== '全部' ? '换个分类或关键词试试。' : '把家里常做的菜记下来吧。'}}"
    >
      <van-button type="primary" round plain bind:click="openCreate">添加菜品</van-button>
    </empty-state>
    <view wx:else class="dish-list">
      <view wx:for="{{dishes}}" wx:key="id" class="dish-card" data-id="{{item.id}}" bindtap="openEdit">
        <dish-avatar name="{{item.name}}" category="{{item.category}}" />
        <view class="dish-main">
          <text class="dish-name ellipsis">{{item.name}}</text>
          <text class="dish-meta ellipsis">{{item.category}}<block wx:if="{{item.remark}}"> · {{item.remark}}</block></text>
        </view>
        <view class="like-button {{item.isFavorite ? 'liked' : ''}}" data-id="{{item.id}}" catchtap="toggleFavorite" aria-role="button" aria-label="{{item.isFavorite ? '取消喜欢' : '喜欢'}}">
          <van-icon name="{{item.isFavorite ? 'like' : 'like-o'}}" size="36rpx" />
        </view>
        <view class="want-pill {{item.ordered ? 'ordered' : item.selected ? 'selected' : ''}}" data-id="{{item.id}}" catchtap="toggleCart" aria-role="button">
          <van-icon wx:if="{{item.selected}}" name="success" size="24rpx" />
          <text>{{item.ordered ? '已点' : item.selected ? '已选' : '想吃'}}</text>
        </view>
      </view>
    </view>
  </block>
</view>

<view wx:if="{{family}}" class="checkout-bar">
  <view class="checkout-info" bindtap="openCart" aria-role="button" aria-label="查看已选菜品">
    <view class="checkout-icon">
      <van-icon name="shopping-cart-o" size="40rpx" info="{{cartItems.length || ''}}" />
    </view>
    <text class="checkout-summary ellipsis {{cartItems.length ? '' : 'empty'}}">{{cartSummary}}</text>
  </view>
  <view class="checkout-submit {{cartItems.length && !submittingCart ? '' : 'disabled'}}" bindtap="submitCart" aria-role="button">
    {{submittingCart ? '加入中…' : '加入今日'}}
  </view>
</view>

<van-popup show="{{showCart}}" position="bottom" round safe-area-inset-bottom bind:close="closeCart">
  <view class="cart-sheet">
    <view class="cart-header">
      <text class="cart-title">已选 {{cartItems.length}} 道</text>
      <text class="cart-clear" bindtap="clearCart">清空</text>
    </view>
    <scroll-view class="cart-list" scroll-y>
      <view wx:for="{{cartItems}}" wx:key="id" class="cart-row">
        <dish-avatar name="{{item.name}}" category="{{item.category}}" size="sm" />
        <text class="cart-name ellipsis">{{item.name}}</text>
        <text class="cart-remove" data-id="{{item.id}}" bindtap="removeCartItem">移除</text>
      </view>
    </scroll-view>
    <van-button type="primary" size="large" round block loading="{{submittingCart}}" loading-text="正在加入…" bind:click="submitCart">加入今日点餐</van-button>
  </view>
</van-popup>
