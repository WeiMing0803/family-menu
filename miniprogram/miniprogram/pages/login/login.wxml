<view class="login-page">
  <view class="login-brand">
    <text class="brand-mark">⌂</text>
    <text class="brand-name">Family Menu</text>
    <text class="muted">把每一顿饭，变成共同的小事。</text>
  </view>
  <view wx:if="{{isDevelopment}}" class="identity-list">
    <text class="identity-title">选择测试身份</text>
    <view
      wx:for="{{identities}}"
      wx:key="openId"
      class="identity-option {{selectedOpenId === item.openId ? 'selected' : ''}}"
      data-openid="{{item.openId}}"
      bindtap="selectIdentity"
      aria-role="radio"
      aria-checked="{{selectedOpenId === item.openId}}"
    >
      <text class="identity-name">{{item.nickName}}</text>
      <text class="identity-id">{{item.openId}}</text>
    </view>
  </view>
  <view wx:if="{{errorMessage}}" class="error-text">{{errorMessage}}</view>
  <button class="primary-button" loading="{{loading}}" disabled="{{loading}}" bindtap="startLogin">{{loginButtonText}}</button>
  <text class="login-hint">{{loginHint}}</text>
</view>
