<navigation-bar title="" back="{{false}}" background="#F7F5EE"></navigation-bar>
<view class="page">
  <view class="page-header">
    <view>
      <text class="page-eyebrow">{{family ? '和家人共享菜单' : '还没有加入家庭'}}</text>
      <text class="page-title">家庭</text>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-banner">
    <text>{{errorMessage}}</text>
    <van-button wx:if="{{!family && !busy}}" size="small" round plain type="danger" bind:click="load">刷新</van-button>
  </view>

  <view wx:if="{{loading}}" class="loading-state">
    <van-loading size="36rpx" color="#86918A" />
    <text>正在读取家庭信息…</text>
  </view>

  <view wx:elif="{{!family}}" class="setup {{fromInvite ? 'join-first' : ''}}">
    <view class="setup-card create-card">
      <view class="setup-heading">
        <view class="setup-icon"><van-icon name="wap-home-o" size="40rpx" /></view>
        <view>
          <text class="setup-title">创建新家庭</text>
          <text class="setup-desc">创建后把邀请码发给家人</text>
        </view>
      </view>
      <view class="field-box">
        <van-field value="{{familyName}}" placeholder="家庭名称（默认：我们的家）" maxlength="{{100}}" border="{{false}}" clearable bind:change="onFamilyNameChange" />
      </view>
      <van-button type="primary" round block loading="{{busy}}" bind:click="create">创建家庭</van-button>
    </view>

    <view class="setup-divider"><text>或者</text></view>

    <view class="setup-card join-card">
      <view class="setup-heading">
        <view class="setup-icon"><van-icon name="friends-o" size="40rpx" /></view>
        <view>
          <text class="setup-title">加入家人的家庭</text>
          <text class="setup-desc">{{fromInvite ? '已从邀请链接填好邀请码' : '输入家人分享的 6 位邀请码'}}</text>
        </view>
      </view>
      <view class="field-box">
        <van-field value="{{inviteCode}}" placeholder="例如 AB23CD" maxlength="{{6}}" border="{{false}}" clearable input-class="invite-input" bind:change="onInviteCodeChange" />
      </view>
      <van-button type="primary" round block plain="{{!fromInvite}}" loading="{{busy}}" bind:click="join">加入家庭</van-button>
    </view>
  </view>

  <block wx:else>
    <view class="invite-card">
      <text class="invite-family">{{family.name}}</text>
      <text class="invite-label">家庭邀请码</text>
      <text class="invite-code" bindlongpress="copyInviteCode">{{family.inviteCode}}</text>
      <view class="invite-actions">
        <view class="invite-action">
          <van-button round block plain color="#FFFFFF" icon="description" bind:click="copyInviteCode">复制邀请码</van-button>
        </view>
        <view class="invite-action">
          <van-button round block open-type="share" icon="share-o" custom-style="color: #1F5A3B; background: #FFFFFF; border-color: #FFFFFF;">分享给家人</van-button>
        </view>
      </view>
    </view>

    <view class="section-title"><text>家庭成员</text><text class="section-hint">{{members.length}}/{{maxMembers}}</text></view>
    <view class="card member-card">
      <view wx:for="{{members}}" wx:key="id" class="member-row">
        <view class="member-avatar {{item.isMe ? 'me' : ''}}">{{item.initial}}</view>
        <text class="member-name">{{item.nickName}}</text>
        <van-tag wx:if="{{item.isMe}}" type="primary" plain round>我</van-tag>
      </view>
      <view wx:if="{{members.length < maxMembers}}" class="member-row waiting">
        <view class="member-avatar placeholder"><van-icon name="plus" /></view>
        <view class="waiting-text">
          <text class="member-name">等待家人加入</text>
          <text class="muted">分享邀请码后，对方点开即可加入</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{!loading}}" class="card settings-card">
    <van-cell wx:if="{{family}}" title="退出家庭" icon="revoke" is-link border="{{false}}" title-style="color: #C8553D" bind:click="leave" />
    <van-cell title="{{signOutText}}" icon="exchange" is-link border="{{false}}" bind:click="signOut" />
  </view>
</view>
