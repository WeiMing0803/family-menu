<view class="empty-state">
  <view class="empty-icon"><van-icon name="{{icon}}" size="56rpx" /></view>
  <text wx:if="{{title}}" class="empty-title">{{title}}</text>
  <text wx:if="{{description}}" class="empty-description">{{description}}</text>
  <view class="empty-action"><slot /></view>
</view>
